# Required: Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Optional: default models
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel KV (set in Vercel project env; optional for local dev)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob (set in Vercel project env; optional for local dev)
BLOB_READ_WRITE_TOKEN=

# Optional storage overrides
# GAMEFORGE_BLOB_PREFIX=gameforge
# GAMEFORGE_DATA_DIR=./.gameforge-data
