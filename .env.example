# Optional Gemini provider (or configure DeepSeek / Qwen below)
GEMINI_API_KEY=

# Optional: default models
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel KV (set in Vercel project env; optional for local dev)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob (set in Vercel project env; optional for local dev)
BLOB_READ_WRITE_TOKEN=

# Optional storage overrides
# GAMEFORGE_BLOB_PREFIX=gameforge
# GAMEFORGE_DATA_DIR=./.gameforge-data

# Compatible providers (server only; never NEXT_PUBLIC_)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GAMEFORGE_TEXT_MODEL=qwen/qwen4-max
GAMEFORGE_IMAGE_MODEL=qwen/qwen-image-3.0
GAMEFORGE_DATA_DIR=./.gameforge-data
# Windows worker uses non-root Linux user and Python venv
GAMEFORGE_WSL_DISTRO=Ubuntu
GAMEFORGE_WSL_USER=zhou1
GAMEFORGE_PYTHON=/opt/gameforge-venv/bin/python
GAMEFORGE_RUNTIME_IMAGE=gameforge/runtime:html-v1
# Required when serving beyond loopback. Browser uses HTTP Basic password.
GAMEFORGE_ACCESS_TOKEN=

# Explicit public origin when deployed behind an HTTPS reverse proxy
# GAMEFORGE_ORIGIN=https://games.example.com

# Darwin evolution / playtest runtime
# docker (default, Linux): isolated container runtime. local: opt-in Chromium sandbox with a network allowlist
# for hosts without Docker (macOS/Windows dev); weaker isolation, recorded in every receipt.
# GAMEFORGE_RUNTIME=local
# GAMEFORGE_PYTHON=/absolute/path/to/.venv-worker/bin/python
